# Supabase (publishable key is public; secret key is server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Daraja / M-Pesa (server-side only)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
MPESA_CALLBACK_URL=

# PayPal (server-side only)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# KES per 1 USD; set and review before enabling PayPal payments.
PAYPAL_KES_TO_USD_RATE=

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
